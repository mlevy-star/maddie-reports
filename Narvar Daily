#!/usr/bin/env python3
"""
Narvar OTP Daily Routine
------------------------
Run each morning at 9:00 AM ET. Queries Snowflake for rolling 7-day
DFLs, RPL, and top advertisers per publisher, detects flags, and posts
a formatted summary to #test-narvar-claude (C0B286G3SPK).

Cron setup (run M-F at 9 AM ET):
    0 9 * * 1-5 TZ="America/New_York" /usr/bin/python3 /path/to/narvar_daily.py >> /tmp/narvar_daily.log 2>&1

Required env vars (add to ~/.zshrc or a .env file):
    SNOWFLAKE_ACCOUNT
    SNOWFLAKE_USER
    SNOWFLAKE_PASSWORD
    SNOWFLAKE_WAREHOUSE
    SNOWFLAKE_DATABASE     (default: DISCO_CORE)
    SNOWFLAKE_ROLE
    SLACK_BOT_TOKEN        (xoxb-...)
"""

import os
import sys
import logging
from datetime import date, timedelta
from collections import defaultdict

import snowflake.connector
from slack_sdk import WebClient
from slack_sdk.errors import SlackApiError

# ── Logging ──────────────────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger(__name__)

# ── Config ───────────────────────────────────────────────────────────────────
SLACK_CHANNEL = "C0B286G3SPK"   # #test-narvar-claude
HEX_LINK = "https://app.hex.tech/01975719-79d0-711b-a61c-0d574da7873a/app/EXT-Narvar-Reporting-031SR1hJTJuTVbRq5TSxa8/latest"

DFL_FLAG_THRESHOLD = -10.0   # % WoW decline
RPL_FLAG_THRESHOLD = -15.0   # % WoW decline
MIN_PRIOR_DFLS     = 1_000   # minimum prior-week DFLs to be included

# ── Date helpers ──────────────────────────────────────────────────────────────
def get_date_ranges():
    today      = date.today()
    yesterday  = today - timedelta(days=1)
    curr_end   = yesterday
    curr_start = yesterday - timedelta(days=6)
    prior_end  = yesterday - timedelta(days=7)
    prior_start = yesterday - timedelta(days=13)
    return {
        "today":       today.strftime("%B %d, %Y"),
        "curr_start":  curr_start.strftime("%b %d"),
        "curr_end":    curr_end.strftime("%b %d"),
        "prior_start": prior_start.strftime("%b %d"),
        "prior_end":   prior_end.strftime("%b %d"),
    }

# ── Snowflake ─────────────────────────────────────────────────────────────────
def get_snowflake_conn():
    return snowflake.connector.connect(
        account=os.environ["SNOWFLAKE_ACCOUNT"],
        user=os.environ["SNOWFLAKE_USER"],
        password=os.environ["SNOWFLAKE_PASSWORD"],
        warehouse=os.environ.get("SNOWFLAKE_WAREHOUSE", ""),
        database=os.environ.get("SNOWFLAKE_DATABASE", "DISCO_CORE"),
        role=os.environ.get("SNOWFLAKE_ROLE", ""),
    )

DFL_SQL = """
WITH daily AS (
    SELECT
        p.publisher_name,
        s.dt,
        COUNT(DISTINCT s.session_id) AS dfls
    FROM DISCO_CORE.MARTS.FCT_SESSIONS s
    JOIN DISCO_CORE.MARTS.DIM_PUBLISHERS p ON s.publisher_id = p.publisher_id
    WHERE s.page_type = 'ORDER_TRACKING'
      AND s.dt BETWEEN DATEADD('day', -13, CURRENT_DATE - 1)
                   AND CURRENT_DATE - 1
    GROUP BY 1, 2
),
current_week AS (
    SELECT publisher_name, SUM(dfls) AS dfls_curr
    FROM daily
    WHERE dt BETWEEN DATEADD('day', -6, CURRENT_DATE - 1) AND CURRENT_DATE - 1
    GROUP BY 1
),
prior_week AS (
    SELECT publisher_name, SUM(dfls) AS dfls_prior
    FROM daily
    WHERE dt BETWEEN DATEADD('day', -13, CURRENT_DATE - 1)
                 AND DATEADD('day', -7, CURRENT_DATE - 1)
    GROUP BY 1
)
SELECT
    c.publisher_name,
    p.dfls_prior,
    c.dfls_curr,
    c.dfls_curr - p.dfls_prior AS abs_change,
    ROUND((c.dfls_curr - p.dfls_prior) / NULLIF(p.dfls_prior, 0) * 100, 1) AS pct_change
FROM current_week c
JOIN prior_week p ON c.publisher_name = p.publisher_name
WHERE p.dfls_prior >= {min_dfls}
ORDER BY pct_change ASC
""".format(min_dfls=MIN_PRIOR_DFLS)

RPL_SQL = """
WITH sessions AS (
    SELECT
        p.publisher_name,
        s.dt,
        COUNT(DISTINCT s.session_id) AS dfls,
        SUM(bs.billable_amount)       AS revenue
    FROM DISCO_CORE.MARTS.FCT_SESSIONS s
    JOIN DISCO_CORE.MARTS.DIM_PUBLISHERS p ON s.publisher_id = p.publisher_id
    JOIN DISCO_CORE.MARTS.FCT_BRAND_SESSIONS bs ON s.session_id = bs.session_id
    WHERE s.page_type = 'ORDER_TRACKING'
      AND s.dt BETWEEN DATEADD('day', -13, CURRENT_DATE - 1)
                   AND CURRENT_DATE - 1
    GROUP BY 1, 2
),
current_week AS (
    SELECT publisher_name,
           SUM(dfls)    AS dfls_curr,
           SUM(revenue) AS rev_curr
    FROM sessions
    WHERE dt BETWEEN DATEADD('day', -6, CURRENT_DATE - 1) AND CURRENT_DATE - 1
    GROUP BY 1
),
prior_week AS (
    SELECT publisher_name,
           SUM(dfls)    AS dfls_prior,
           SUM(revenue) AS rev_prior
    FROM sessions
    WHERE dt BETWEEN DATEADD('day', -13, CURRENT_DATE - 1)
                 AND DATEADD('day', -7, CURRENT_DATE - 1)
    GROUP BY 1
)
SELECT
    c.publisher_name,
    ROUND(p.rev_prior / NULLIF(p.dfls_prior, 0), 6) AS rpl_prior,
    ROUND(c.rev_curr  / NULLIF(c.dfls_curr,  0), 6) AS rpl_curr,
    ROUND(
        ((c.rev_curr / NULLIF(c.dfls_curr, 0))
       - (p.rev_prior / NULLIF(p.dfls_prior, 0)))
      / NULLIF(p.rev_prior / NULLIF(p.dfls_prior, 0), 0) * 100,
    1) AS rpl_pct_change
FROM current_week c
JOIN prior_week p ON c.publisher_name = p.publisher_name
ORDER BY rpl_pct_change ASC
"""

def advertisers_sql(flagged_publishers: list[str]) -> str:
    quoted = ", ".join(f"'{p}'" for p in flagged_publishers)
    return f"""
WITH ranked AS (
    SELECT
        p.publisher_name,
        b.brand_name,
        CASE
            WHEN s.dt BETWEEN DATEADD('day', -6, CURRENT_DATE - 1) AND CURRENT_DATE - 1
            THEN 'curr'
            ELSE 'prior'
        END AS wk,
        SUM(bs.billable_amount) AS revenue,
        COUNT(DISTINCT s.session_id) AS dfls,
        ROW_NUMBER() OVER (
            PARTITION BY p.publisher_name,
                         CASE
                             WHEN s.dt BETWEEN DATEADD('day', -6, CURRENT_DATE - 1) AND CURRENT_DATE - 1
                             THEN 'curr' ELSE 'prior'
                         END
            ORDER BY SUM(bs.billable_amount) DESC
        ) AS rnk
    FROM DISCO_CORE.MARTS.FCT_SESSIONS s
    JOIN DISCO_CORE.MARTS.DIM_PUBLISHERS p ON s.publisher_id = p.publisher_id
    JOIN DISCO_CORE.MARTS.FCT_BRAND_SESSIONS bs ON s.session_id = bs.session_id
    JOIN DISCO_CORE.MARTS.DIM_BRANDS b ON bs.brand_id = b.brand_id
    WHERE s.page_type = 'ORDER_TRACKING'
      AND s.dt BETWEEN DATEADD('day', -13, CURRENT_DATE - 1) AND CURRENT_DATE - 1
      AND p.publisher_name IN ({quoted})
    GROUP BY 1, 2, 3
)
SELECT publisher_name, wk, brand_name, ROUND(revenue, 2) AS revenue, rnk
FROM ranked
WHERE rnk <= 5
ORDER BY publisher_name, wk DESC, rnk
"""

def run_query(conn, sql: str) -> list[dict]:
    cur = conn.cursor()
    cur.execute(sql.strip())
    cols = [d[0].lower() for d in cur.description]
    return [dict(zip(cols, row)) for row in cur.fetchall()]

# ── Flagging logic ────────────────────────────────────────────────────────────
def classify(dfl_pct, rpl_pct) -> str:
    dfl_flag = dfl_pct is not None and dfl_pct < DFL_FLAG_THRESHOLD
    rpl_flag = rpl_pct is not None and rpl_pct < RPL_FLAG_THRESHOLD
    if dfl_flag and rpl_flag:
        return "double"
    if dfl_flag:
        return "dfl"
    if rpl_flag:
        return "rpl"
    return "ok"

def sort_key(flag: str) -> int:
    return {"double": 0, "dfl": 1, "rpl": 2, "ok": 3}[flag]

FLAG_EMOJI = {"double": "🚨", "dfl": "🔴", "rpl": "⚠️", "ok": "✅"}

# ── Cross-publisher advertiser pattern detection ───────────────────────────────
def detect_cross_publisher_patterns(adv_data: list[dict], flagged_pubs: set[str]) -> list[str]:
    """
    Returns bullet-point strings for the Network TLDR section.
    - New entries appearing across 2+ flagged publishers → demand shift signal
    - Revenue declines across 3+ flagged publishers → budget/bid change signal
    """
    # Build per-publisher brand sets
    prior_brands: dict[str, set] = defaultdict(set)
    curr_brands:  dict[str, set] = defaultdict(set)
    brand_rev:    dict[str, dict] = defaultdict(lambda: {"prior": 0.0, "curr": 0.0})

    for row in adv_data:
        pub   = row["publisher_name"]
        brand = row["brand_name"]
        wk    = row["wk"]
        rev   = float(row["revenue"] or 0)
        if wk == "prior":
            prior_brands[pub].add(brand)
            brand_rev[brand]["prior"] += rev
        else:
            curr_brands[pub].add(brand)
            brand_rev[brand]["curr"] += rev

    # New entrants: in curr but NOT in prior for a given publisher
    new_entry_count: dict[str, int] = defaultdict(int)
    for pub in flagged_pubs:
        new_entries = curr_brands.get(pub, set()) - prior_brands.get(pub, set())
        for brand in new_entries:
            new_entry_count[brand] += 1

    # Revenue decliners across publishers
    decline_count: dict[str, int] = defaultdict(int)
    for pub in flagged_pubs:
        for brand in curr_brands.get(pub, set()) & prior_brands.get(pub, set()):
            curr_rev  = brand_rev[brand]["curr"]
            prior_rev = brand_rev[brand]["prior"]
            if prior_rev > 0 and (curr_rev - prior_rev) / prior_rev < -0.10:
                decline_count[brand] += 1

    bullets = []
    for brand, count in sorted(new_entry_count.items(), key=lambda x: -x[1]):
        if count >= 2:
            bullets.append(
                f"• *{brand}* entered top 5 on {count} publishers — possible low-CPM backfill signal. Flag to demand team."
            )
    for brand, count in sorted(decline_count.items(), key=lambda x: -x[1]):
        if count >= 3:
            bullets.append(
                f"• *{brand}* revenue down across {count} publishers — possible budget or bid change."
            )
    return bullets

# ── Slack message builders ────────────────────────────────────────────────────
def format_pct(v) -> str:
    if v is None:
        return "N/A"
    sign = "+" if v > 0 else ""
    return f"{sign}{v:.1f}%"

def build_publisher_table(merged: list[dict]) -> str:
    header = "Publisher | DFLs | DFL WoW | RPL | RPL WoW"
    rows = [header]
    for pub in merged:
        emoji = FLAG_EMOJI[pub["flag"]]
        rpl_curr = pub.get("rpl_curr")
        rpl_str  = f"${rpl_curr:.4f}" if rpl_curr is not None else "N/A"
        rows.append(
            f"{pub['publisher_name']} {emoji} | "
            f"{int(pub['dfls_curr']):,} | "
            f"{format_pct(pub.get('dfl_pct'))} | "
            f"{rpl_str} | "
            f"{format_pct(pub.get('rpl_pct'))}"
        )
    return "\n".join(rows)

def build_main_message(merged: list[dict], dates: dict, network_bullets: list[str]) -> str:
    lines = [
        f"*📊 Narvar OTP Daily Brief — {dates['today']}*",
        f"*Rolling 7d: {dates['curr_start']}–{dates['curr_end']} vs {dates['prior_start']}–{dates['prior_end']}*",
        "",
    ]

    # Network TLDR
    if network_bullets:
        lines.append("*📌 Network TLDR*")
        lines.extend(network_bullets)
        lines.append("")

    double_flagged = [p for p in merged if p["flag"] == "double"]
    dfl_only       = [p for p in merged if p["flag"] == "dfl"]
    rpl_only       = [p for p in merged if p["flag"] == "rpl"]

    any_flags = double_flagged or dfl_only or rpl_only

    if not any_flags:
        lines.append("✅ *All publishers healthy — no DFL or RPL flags today.*")
        lines.append("")
    else:
        if double_flagged:
            lines.append("*🚨 Double Flags — escalate same day*")
            for p in double_flagged:
                lines.append(
                    f"🔴 *{p['publisher_name']}* | "
                    f"DFLs {format_pct(p.get('dfl_pct'))} · RPL {format_pct(p.get('rpl_pct'))}"
                )
            lines.append("")

        if dfl_only:
            lines.append("*🔴 DFL Flags — >10% WoW decline*")
            for p in dfl_only:
                lines.append(
                    f"▼ *{p['publisher_name']}* | DFLs {format_pct(p.get('dfl_pct'))}"
                )
            lines.append("")

        if rpl_only:
            lines.append("*⚠️ RPL Flags — revenue per load declining >15%*")
            for p in rpl_only:
                lines.append(
                    f"↘ *{p['publisher_name']}* | "
                    f"RPL {format_pct(p.get('rpl_pct'))} · DFLs {format_pct(p.get('dfl_pct'))}"
                )
            lines.append("")

    lines.append("*📈 All Publishers*")
    lines.append(build_publisher_table(merged))
    lines.append("")
    lines.append(f"_<{HEX_LINK}|📎 Full Narvar report> · Advertiser detail by publisher 👇_")

    return "\n".join(lines)

def build_advertiser_thread(adv_data: list[dict], flagged_pubs: list[str], rpl_map: dict) -> str:
    lines = ["*🔍 Advertiser mix detail — flagged publishers*", ""]

    # Organize: publisher → wk → [(brand, revenue)]
    pub_wk: dict[str, dict] = defaultdict(lambda: {"prior": [], "curr": []})
    for row in adv_data:
        pub_wk[row["publisher_name"]][row["wk"]].append(
            (row["brand_name"], float(row["revenue"] or 0))
        )

    for pub in flagged_pubs:
        rpl_pct = rpl_map.get(pub)
        rpl_str = format_pct(rpl_pct) if rpl_pct is not None else "N/A"
        lines.append(f"*{pub}* (RPL {rpl_str})")

        prior_list = sorted(pub_wk[pub]["prior"], key=lambda x: -x[1])
        curr_list  = sorted(pub_wk[pub]["curr"],  key=lambda x: -x[1])
        prior_names = {b for b, _ in prior_list}

        prior_str = " · ".join(f"{b} ${r:,.0f}" for b, r in prior_list) or "—"
        curr_parts = []
        for brand, rev in curr_list:
            if brand not in prior_names:
                curr_parts.append(f"{brand} ${rev:,.0f} 🆕")
            else:
                prior_rev = next((r for b, r in prior_list if b == brand), 0)
                arrow = "↑" if rev >= prior_rev else "↓"
                curr_parts.append(f"{brand} ${rev:,.0f} {arrow}")
        curr_str = " · ".join(curr_parts) or "—"

        lines.append(f"Prior: {prior_str}")
        lines.append(f"Curr:  {curr_str}")
        lines.append("")

    return "\n".join(lines)

# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    log.info("Starting Narvar OTP daily routine")
    dates = get_date_ranges()

    # 1. Pull data from Snowflake
    log.info("Connecting to Snowflake")
    conn = get_snowflake_conn()

    log.info("Pulling DFL data")
    dfl_rows = run_query(conn, DFL_SQL)

    log.info("Pulling RPL data")
    rpl_rows = run_query(conn, RPL_SQL)

    # 2. Merge DFL + RPL into a single publisher dict
    dfl_map = {r["publisher_name"]: r for r in dfl_rows}
    rpl_map = {r["publisher_name"]: r for r in rpl_rows}
    all_pubs = sorted(set(dfl_map) | set(rpl_map))

    merged = []
    for pub in all_pubs:
        dfl = dfl_map.get(pub, {})
        rpl = rpl_map.get(pub, {})
        dfl_pct = dfl.get("pct_change")
        rpl_pct = rpl.get("rpl_pct_change")
        flag    = classify(dfl_pct, rpl_pct)
        merged.append({
            "publisher_name": pub,
            "dfls_curr":      dfl.get("dfls_curr", 0),
            "dfl_pct":        dfl_pct,
            "rpl_curr":       rpl.get("rpl_curr"),
            "rpl_pct":        rpl_pct,
            "flag":           flag,
        })

    # Sort: double → dfl → rpl → ok
    merged.sort(key=lambda x: sort_key(x["flag"]))

    # 3. Identify flagged publishers and pull advertiser detail
    flagged_pubs = [p["publisher_name"] for p in merged if p["flag"] != "ok"]
    adv_data = []
    if flagged_pubs:
        log.info(f"Pulling advertiser detail for {len(flagged_pubs)} flagged publishers")
        adv_data = run_query(conn, advertisers_sql(flagged_pubs))

    conn.close()

    # 4. Cross-publisher pattern detection
    network_bullets = detect_cross_publisher_patterns(adv_data, set(flagged_pubs))

    # 5. Build Slack messages
    rpl_pct_map = {r["publisher_name"]: r.get("rpl_pct_change") for r in rpl_rows}
    main_msg = build_main_message(merged, dates, network_bullets)

    # 6. Post to Slack
    slack = WebClient(token=os.environ["SLACK_BOT_TOKEN"])

    log.info(f"Posting main brief to {SLACK_CHANNEL}")
    try:
        resp = slack.chat_postMessage(channel=SLACK_CHANNEL, text=main_msg)
        thread_ts = resp["ts"]
    except SlackApiError as e:
        log.error(f"Failed to post main message: {e.response['error']}")
        sys.exit(1)

    # Post advertiser thread only if there are flags
    if flagged_pubs and adv_data:
        thread_msg = build_advertiser_thread(adv_data, flagged_pubs, rpl_pct_map)
        log.info("Posting advertiser detail as thread reply")
        try:
            slack.chat_postMessage(
                channel=SLACK_CHANNEL,
                text=thread_msg,
                thread_ts=thread_ts,
            )
        except SlackApiError as e:
            log.error(f"Failed to post thread: {e.response['error']}")

    log.info("Done ✅")


if __name__ == "__main__":
    main()
